---
// Home, told as a StoryBrand story with the integrator as the hero and Flywheel as the guide:
// the hero and what they want → the problem (external, internal, philosophical) → the guide (empathy and
// authority) → the plan → the staff → the network → what's at stake → the call to action (closing band).
import Base from '../layouts/Base.astro';
import SeatProfile from '../components/SeatProfile.astro';
import NetworkDiagram from '../components/NetworkDiagram.astro';
import FaqList from '../components/FaqList.astro';
import { SITE, STAFF, PROOF } from '../site';
import type { Faq } from '../schema';

const open = SITE.seats.total - SITE.seats.committed;
const problems = [
  { t: 'Marketing', p: 'It gets posted when there’s time, and there’s never time.' },
  { t: 'Follow-up', p: 'Quotes and leads go cold while the team is on a job site.' },
  { t: 'Service triage', p: 'The same two people route every ticket, nights and weekends included.' },
  { t: 'Back office', p: 'Nobody has the hours to look for what the numbers are hiding.' },
];

const plan = [
  { t: 'Own your data', p: 'We set up a data warehouse in your firm’s name. You give us one login to it, and you can take it back with one click.' },
  { t: 'Hire the seat that hurts most', p: 'Each AI employee gets a name, a job description, one number to move, a manager on your team and a 90-day probation.' },
  { t: 'Join the network', p: 'Your staff learns from what works at every member firm. Your customer records stay in your warehouse.' },
];

const without = [
  'Leads go cold between the job site and the office.',
  'Service calls land on the owner’s phone at 9 p.m.',
  'Every hire takes months to find and train, and you start over when someone leaves.',
  'You learn every hard lesson alone.',
];
const withFw = [
  'Every quote gets followed up, every week, without anyone having to remember.',
  'Service gets a first response in minutes and a diagnosis before a truck rolls.',
  'Your staff gets better every month and answers to your people.',
  'You run the firm with the playbooks of the best integrators in the channel behind you.',
];

const points = [
  { href: '/ai-staff/', t: 'Four seats', p: 'Marketing, Outbound, Support and System Designer. Each gets a name, a job description, one number to move, a human manager and a 90-day probation.' },
  { href: '/how-it-works/#trust', t: 'Your records stay put', p: 'Patterns, playbooks and benchmarks travel. Each member owns its warehouse. One credential in, one revocation out and each seat opts in on its own.' },
  { href: '/network/#contributor-pool', t: 'Barn-raising, paid', p: 'Ten percent of every subscription dollar is paid each quarter to the members whose tools the community uses.' },
  { href: '/apply/', t: 'Five founding seats', p: `${open} are still open, and the window closes at launch. Referral cash, 12 months alone in your metro, a product council seat and lifetime pricing.` },
  { href: '/community/', t: 'Partner circle', p: 'Builders and consultants can join, refer a firm and get paid when the community uses what they build.' },
];

const prices = [
  { tier: 'Good', name: 'One hire', price: '$749' },
  { tier: 'Better', name: 'Three hires', price: '$1,749', featured: true },
  { tier: 'Best', name: 'The full staff', price: '$3,499' },
];

const faqs: Faq[] = [
  { q: 'What is Flywheel?', a: 'Flywheel is a community-powered AI platform for custom integration firms. It gives each member firm AI employees for marketing, outbound sales, service triage and system design, which the team reaches by text like any coworker. Each firm owns its own data warehouse, and the patterns learned across member firms make every member’s staff better.' },
  { q: 'Do I have to replace my CRM or the tools I use?', a: 'No. The staff works on top of the tools you already run, such as QuickBooks, your CRM and your ticketing, through one login you give us. When Flywheel builds a connector for one member, every member on that tool gets it.' },
  { q: 'Who owns my data?', a: 'You do. Your warehouse is in your firm’s name from day one, and Flywheel works on credentialed access only. Customer records are never pooled or resold. Only anonymized patterns go to the network, and aggregates are never cut thin enough to identify a member.' },
  { q: 'How is this different from hiring a consultant?', a: 'A consultant maps the problem and leaves. Flywheel’s staff does the work every week, is measured on one number per seat, and gets better as the network grows. It was built and proven inside Livewire, a working integration firm, before it was offered to anyone else.' },
  { q: 'What does it cost?', a: 'Plans are priced by headcount: one hire is $749 a month, three hires with your own warehouse is $1,749, and the full staff with the System Designer and a quarterly numbers review is $3,499. Every account has a one-time $4,999 setup fee.' },
  { q: 'What if an AI employee doesn’t work out?', a: 'Every seat starts on a 90-day probation with one number it’s expected to move. If it doesn’t move it, you let it go, the same as any hire.' },
];
---
<Base
  title="Flywheel · AI staff for custom integrators"
  description="Flywheel gives integration firms AI employees for marketing, outbound, service triage and system design. Your team texts them like coworkers, your data stays in a warehouse you own, and every member firm makes your staff smarter."
  faqs={faqs}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">AI staff for custom integrators</p>
      <h1>Your firm, <span class="ochre">fully staffed.</span></h1>
      <div class="hero-grid">
        <div>
          <p class="lede">You started an integration firm to do great work for clients. Flywheel gives you AI employees for the marketing, follow-up and service calls that pile up in the meantime. Your team texts them like coworkers.</p>
          <div class="actions">
            <a class="btn primary" href={SITE.applyUrl} data-track="cta_click" data-label="Apply (hero)">Apply for a founding seat</a>
            <p class="open-count">{open} of {SITE.seats.total} open</p>
          </div>
          <p class="caption">Owners and technicians comparing notes. Every member makes the network smarter.</p>
        </div>
        <div>
          <p class="eyebrow">Proof · Livewire, client zero</p>
          <div class="stats">
            {PROOF.map((s) => (
              <div class="stat">
                <b>{s.value}{s.unit ? ` ${s.unit}` : ''}</b>
                <span>{s.label}</span>
              </div>
            ))}
          </div>
          <p class="caption">At Livewire, the AI staff books <b>47 outbound conversations</b> a month, answers service requests in <b>3&nbsp;minutes</b> and keeps <b>34 permit-sourced projects</b> in the pipeline.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="problem">
    <div class="wrap">
      <p class="eyebrow">The problem</p>
      <h2>Every integrator solves the same problems alone.</h2>
      <p class="lede" style="margin-top:18px">Hiring is slow and expensive. Consultants map the problem and leave. So the owner ends up as the marketing department, the follow-up desk and the after-hours dispatcher.</p>
      <div class="ruled" style="margin-top:28px">
        {problems.map((r, i) => (
          <div>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{r.t}</h3>
            <p>{r.p}</p>
          </div>
        ))}
      </div>
      <p class="aside">And the lessons each firm learns the hard way stay inside its own four walls.</p>
    </div>
  </section>

  <section class="band amber">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Built in Richmond since 2002</p>
        <h2>We run an integration firm too.</h2>
      </div>
      <div>
        <p class="lede">Flywheel was built inside Livewire, which has installed and serviced technology in Richmond since 2002.</p>
        <p class="measure">We know what a truck roll costs and what a Friday service call does to a weekend. We put these AI employees on our own payroll first, held each one to a single number, and kept only the ones that moved it. Now we’re offering the same staff to a small group of firms, and building the network we wish we’d had.</p>
        <a class="more" href="/about/">Read the Livewire story</a>
      </div>
    </div>
  </section>

  <section class="band" id="plan">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Three steps to a fully staffed firm.</h2>
      <p class="lede" style="margin-top:18px">There’s no software to build or host and nothing to rip out. You keep your data, your customers and the final say on everything that goes out.</p>
      <ol class="step-cards">
        {plan.map((s, i) => (
          <li>
            <span class="n">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>
      <p class="after"><a class="more" href="/how-it-works/">See the details</a></p>
    </div>
  </section>

  <section class="band" id="staff">
    <div class="wrap">
      <p class="eyebrow">The staff</p>
      <h2>Four seats, each measured on one number.</h2>
      <p class="lede" style="margin-top:18px">You name them, someone on your team manages them, and anyone can text them. Each one starts on a 90-day probation.</p>
      <div class="seats" style="margin-top:28px">
        {STAFF.map((s) => <SeatProfile seat={s.seat} role={s.role} line={s.line} moves={s.moves} reports={s.reports} />)}
      </div>
      <p class="after"><a class="more" href="/ai-staff/">What each seat does</a></p>
    </div>
  </section>

  <section class="band" id="network">
    <div class="wrap split">
      <div>
        <p class="eyebrow">The network</p>
        <h2>Your data stays home. What works gets shared.</h2>
        <p class="measure" style="margin-top:20px">Every member keeps its customer records in its own warehouse. What the network shares is the pattern: the follow-up cadence that books the meeting, the triage step that saves a truck roll. When one member’s staff gets better, every member’s does.</p>
        <p class="measure">Members who build a tool the community uses are paid from the contributor pool every quarter it runs.</p>
        <a class="more" href="/network/">How the network works</a>
      </div>
      <NetworkDiagram />
    </div>
  </section>

  <section class="band" id="community">
    <div class="wrap">
      <p class="eyebrow">Livewire is client zero</p>
      <h2>The Flywheel spins faster with every firm that joins.</h2>
      <p class="lede" style="margin-top:18px;max-width:68ch">Named AI employees you text like staff. A network where patterns travel and customer records never do. A contributor pool that pays the members whose tools everyone uses. Livewire is client zero.</p>
      <ul class="points">
        {points.map((item) => (
          <li>
            <h3><a href={item.href}>{item.t}</a></h3>
            <p>{item.p}</p>
          </li>
        ))}
      </ul>
      <p class="after"><a class="more" href="/community/">How the community works</a></p>
    </div>
  </section>

  <section class="band" id="pricing">
    <div class="wrap">
      <p class="eyebrow">Good, better, best</p>
      <h2>Priced by headcount.</h2>
      <p class="lede" style="margin-top:18px;max-width:62ch">One hire is $749 a month, three hires are $1,749 and the full staff is $3,499. Lease or build. Setup is $4,999 once.</p>
      <div class="price-cards" style="margin-top:28px">
        {prices.map((p) => (
          <a class:list={['price', { featured: p.featured }]} href="/pricing/">
            <span class="eyebrow">{p.tier}</span>
            <h3>{p.name}</h3>
            <p class="amt"><b>{p.price}</b><span>/month</span></p>
          </a>
        ))}
      </div>
      <div class="setup-row">
        <span class="eyebrow">One-time setup</span>
        <b>$4,999</b>
      </div>
      <p class="after"><a class="more" href="/pricing/">See what each plan includes</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>The channel is going to get AI staff. The question is whose.</h2>
      <p class="lede" style="margin-top:18px">The firms that staff up first will answer faster, follow up longer and learn quicker than the firm down the street.</p>
      <div class="stakes" style="margin-top:28px">
        <div>
          <h3>If nothing changes</h3>
          <ul>{without.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="win">
          <h3>With a Flywheel staff</h3>
          <ul>{withFw.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} />
</Base>
