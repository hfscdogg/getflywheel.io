---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const why = [
  { t: 'Decades of trust', p: 'In this channel the calls get returned. We’ve been on the other end of them since 1994.' },
  { t: 'One tool stack', p: 'Integrators run the same systems. A connector built once works for every member on that tool.' },
  { t: 'Staff already working', p: 'The AI employees are producing in a real firm with a real P&L, not sitting on a roadmap.' },
  { t: 'The timing', p: 'The channel is going to get AI staff from someone. It should come from integrators.' },
];
---
<Base title="About Flywheel" description="Flywheel was built inside Livewire, a Richmond, Virginia integration firm since 1994, and proven on its own P&L before being offered to other integrators." crumbs={[{ name: 'About', url: '/about/' }]}>
  <PageHero crumb="About" title="Built inside a working integration firm." lede="Flywheel isn’t a software company that discovered the channel. It’s an integrator that got tired of solving the same problems alone." />

  <section class="band">
    <div class="wrap pair">
      <figure class="photo">
        <img src="/photos/livewire-van.jpg" alt="A Livewire service van parked outside the Livewire office in Richmond" width="1000" height="550" loading="lazy" />
        <figcaption>Livewire, Richmond, Virginia. Flywheel’s client zero.</figcaption>
      </figure>
      <div class="prose">
        <h2>We hired the staff ourselves first.</h2>
        <p>Livewire has designed, installed and serviced home and commercial technology in Central Virginia since 1994. Like every integrator, it ran into the same four walls: marketing that only happened when there was time, quotes that went cold, service tickets routed by the same two people and back-office questions nobody had hours to chase.</p>
        <p>So we built AI employees to take that work, put them on our own payroll and held each one to a single number. The ones that moved their number stayed. The ones that didn’t were rebuilt or let go.</p>
        <p>Flywheel started in 2025 building tools for integrators: Lifecycle, Permit Miner and Intel Engine. In 2026 it relaunched as a community, offering the same staff to a small group of founding firms and getting better with every firm that joins.</p>
      </div>
    </div>
  </section>

  <section class="yellow band tight">
    <div class="wrap">
      <p class="proof">At Livewire today, the AI staff books <b>47 outbound conversations</b> a month, answers service requests in <b>3&nbsp;minutes</b> and keeps <b>34 permit-sourced projects</b> in the pipeline.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="intro"><h2>Why a fast follower can’t catch up</h2></div>
      <div class="items">
        {why.map((r) => <div><h3>{r.t}</h3><p>{r.p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="bone band">
    <div class="wrap pair">
      <div>
        <h2>Run by owners</h2>
      </div>
      <div class="prose">
        <p><b>Henry Clifford</b>, co-founder, runs Livewire, the firm where every Flywheel AI employee goes to work first.</p>
        <p>Flywheel’s product council is made up of the owners of its founding member firms. They decide what gets built next, because they’re the ones who have to run it on Monday.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .prose h2 { margin-bottom: 20px; }
  .prose p { color: var(--ink-soft); }
  .pair { align-items: start; }
  .proof { margin: 0; font-family: var(--head); font-weight: 600; font-style: italic; font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.25; max-width: 32ch; }
  .proof b { font-style: normal; font-weight: 700; }
</style>
