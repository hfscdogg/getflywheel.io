---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NetworkDiagram from '../components/NetworkDiagram.astro';
import FaqList from '../components/FaqList.astro';
import type { Faq } from '../schema';

const statement = [
  { tool: 'Quote follow-up sequence', by: 'Member firm A', share: 40 },
  { tool: 'Service triage playbook', by: 'Member firm B', share: 30 },
  { tool: 'Permit outreach script', by: 'Member firm C', share: 20 },
  { tool: 'QuickBooks connector', by: 'Partner builder', share: 10 },
];

const faqs: Faq[] = [
  { q: 'What does the network share, exactly?', a: 'Patterns, playbooks and benchmarks: which follow-up cadence books meetings, which triage steps avoid a truck roll, how a firm’s numbers compare with the channel. Customer records, names and job details never leave a member’s warehouse.' },
  { q: 'How does the contributor pool work?', a: 'Ten percent of every subscription dollar goes into the pool. Each quarter it’s split by usage among the members and builders whose tools did the work, on one statement. Usage decides the split, not negotiation.' },
  { q: 'What do members earn for referrals?', a: 'Twenty percent of a referred firm’s subscription in its first year and ten percent for as long as it stays a member. Channel consultants who bring firms in earn on the same terms.' },
  { q: 'What does metro exclusivity mean?', a: 'A founding member is the only Flywheel firm in its metro for 12 months. Its direct competitors can’t buy a seat during that time.' },
];
---
<Base title="The member network" description="How the Flywheel network works for integration firms: customer data stays in each member's own warehouse, patterns and playbooks are shared, and a contributor pool pays members whose tools the community uses." crumbs={[{ name: 'The network', url: '/network/' }]} faqs={faqs}>
  <PageHero crumb="The network" title="Anyone can copy the agents. Nobody can copy the members." lede="Every firm that joins makes every other firm’s staff a little better. That’s the whole idea behind the name." />

  <section class="band">
    <div class="wrap pair">
      <NetworkDiagram />
      <div>
        <h2>How it works</h2>
        <p class="measure">Each member runs separately, with its own warehouse and its own login. When something works at one firm, a person reviews it before it goes to the network. It comes back to every member as a better AI employee.</p>
        <p class="measure">In year one that’s five firms and four seats. By year three it’s the same four seats with hundreds of firms’ patterns behind them, and a quarterly benchmark of the channel that nobody outside the network can buy.</p>
      </div>
    </div>
  </section>

  <section class="bone band" id="contributor-pool">
    <div class="wrap pair">
      <div>
        <h2>The contributor pool</h2>
        <p class="lede">Barn-raising, paid. Ten percent of every subscription dollar goes to the members whose tools did the work, split by usage and paid every quarter.</p>
        <p class="measure">The people best placed to compete with Flywheel are paid to build it instead.</p>
      </div>
      <figure class="stmt">
        <table>
          <caption>Example quarterly statement</caption>
          <thead><tr><th scope="col">Tool</th><th scope="col">Built by</th><th scope="col" class="num">Share</th></tr></thead>
          <tbody>
            {statement.map((s) => <tr><td>{s.tool}</td><td>{s.by}</td><td class="num">{s.share}%</td></tr>)}
          </tbody>
        </table>
        <figcaption>Illustration. Real statements list your own tools and amounts.</figcaption>
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="wrap pair flip">
      <figure class="photo">
        <img src="/photos/technician-training.jpg" alt="Livewire technicians in safety vests at a training session around a long table" width="1000" height="550" loading="lazy" />
        <figcaption>Technician training at Livewire.</figcaption>
      </figure>
      <div>
        <h2>Bring a firm in, and keep earning on it.</h2>
        <p class="measure">Members and channel consultants earn 20% of a referred firm’s subscription in its first year and 10% for as long as it stays. Founding members also get their metro to themselves for 12 months.</p>
        <div class="actions">
          <a class="btn primary" href="/apply/" data-track="cta_click" data-label="Apply (partner circle)">Apply to join</a>
        </div>
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} />
</Base>

<style>
  .pair h2 + .measure, .pair h2 + .lede { margin-top: 20px; }
  .stmt { margin: 0; background: var(--white); border: 1px solid var(--rule); border-radius: 2px; padding: 8px 24px 16px; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-family: var(--head); font-weight: 700; font-size: 1.2rem; padding: 14px 0 10px; }
  th { text-align: left; font-size: 0.85rem; font-weight: 600; color: var(--mute); padding: 10px 0; border-bottom: 1px solid var(--rule); }
  td { padding: 14px 12px 14px 0; border-bottom: 1px solid var(--rule); }
  td:first-child { font-weight: 600; }
  .num { text-align: right; padding-right: 0; }
  .stmt figcaption { padding-top: 12px; font-size: 0.85rem; color: var(--mute); }
</style>
