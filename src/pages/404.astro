---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist." noindex cta={false}>
  <section class="page-hero dark">
    <div class="wrap">
      <p class="label">404</p>
      <h1>Wrong turn.</h1>
      <p class="lede">That page isn’t here. The rest of the wheel is.</p>
      <div class="actions">
        <a class="btn signal" href="/">Back to the home page</a>
        <a class="btn ghost" href="/how-it-works/">How it works</a>
      </div>
    </div>
  </section>
</Base>
