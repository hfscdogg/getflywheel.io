---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist." noindex cta={false}>
  <section class="page-hero">
    <div class="wrap">
      <h1>That page isn’t here.</h1>
      <p class="lede">It may have moved when the site was rebuilt.</p>
      <div class="actions">
        <a class="btn primary" href="/">Go to the home page</a>
        <a class="btn quiet" href="/how-it-works/">How it works</a>
      </div>
    </div>
  </section>
</Base>
