---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import { SITE } from '../site';
import type { Faq } from '../schema';

const plans = [
  { name: 'One hire', price: 749, line: 'Start with the seat that hurts most.', items: ['Any one seat: Marketing, Outbound or Support', 'A weekly brief to your approver', 'Patterns and playbooks from the network'] },
  { name: 'Three hires', price: 1749, line: 'The core staff, plus your own warehouse.', items: ['Marketing, Outbound and Support', 'A data warehouse in your firm’s name', 'A weekly brief from each seat', 'Network patterns and benchmarks'], featured: true },
  { name: 'Full staff', price: 3499, line: 'Every seat, and a quarterly sit-down with the owner.', items: ['All four seats, including System Designer', 'A data warehouse in your firm’s name', 'A quarterly numbers review with the owner', 'Network patterns and benchmarks'] },
];

const faqs: Faq[] = [
  { q: 'Is there a setup fee?', a: 'Yes. Every account has a one-time $4,999 setup fee, which covers the business brief, building the warehouse, connecting your systems and the baseline each seat is measured against.' },
  { q: 'How long is the commitment?', a: 'A 90-day first term, matching each seat’s probation, then month to month.' },
  { q: 'Why price by headcount?', a: 'Because that’s the comparison an owner actually makes. A seat costs a fraction of a hire’s salary and benefits, starts in weeks instead of months and doesn’t leave for the competitor down the street.' },
  { q: 'What do founding members pay?', a: 'Founding members lock in their price for life, plus 12 months as the only Flywheel firm in their metro, a vote on what gets built next and referral income on every firm they bring in.' },
];

const offers = plans.map((p) => ({
  '@type': 'Offer', name: `Flywheel ${p.name}`, description: p.line, price: p.price, priceCurrency: 'USD',
  priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price, priceCurrency: 'USD', unitCode: 'MON', referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' } },
  url: new URL('/pricing/', SITE.url).href,
}));
const schema = [{ '@type': 'Service', '@id': `${SITE.url}pricing/#service`, name: 'Flywheel AI staff for integrators', serviceType: 'AI employees for custom integration firms', provider: { '@id': `${SITE.url}#organization` }, offers }];
---
<Base title="Pricing" description="Flywheel pricing for custom integration firms: One hire at $749 a month, Three hires with your own data warehouse at $1,749, or the Full staff at $3,499. One-time $4,999 setup. 90-day first term, then month to month." crumbs={[{ name: 'Pricing', url: '/pricing/' }]} faqs={faqs} schema={schema}>
  <PageHero crumb="Pricing" title="Priced by the seat, compared against payroll." lede="Put a seat next to what a hire costs you in salary, benefits, training and turnover. Then pick the seat that hurts most." />

  <section class="band">
    <div class="wrap">
      <div class="plans">
        {plans.map((p) => (
          <article class:list={['plan', { featured: p.featured }]}>
            <p class="flag" aria-hidden={p.featured ? undefined : 'true'}>{p.featured ? 'Where most firms start' : '\u00a0'}</p>
            <h2>{p.name}</h2>
            <p class="line">{p.line}</p>
            <p class="price"><b>${p.price.toLocaleString('en-US')}</b> a month</p>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
            <a class:list={['btn', { primary: p.featured }]} href={SITE.applyUrl} data-track="cta_click" data-label={`Apply (${p.name})`}>Apply</a>
          </article>
        ))}
      </div>
      <dl class="terms">
        <div><dt>Setup</dt><dd>$4,999 once: business brief, warehouse, connections and baseline.</dd></div>
        <div><dt>Term</dt><dd>90 days to start, then month to month.</dd></div>
        <div><dt>Lease or build</dt><dd>We run it monthly, or you own it outright and we hand over the keys.</dd></div>
      </dl>
    </div>
  </section>

  <FaqList faqs={faqs} />
</Base>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .plan { display: flex; flex-direction: column; padding: 32px 28px; background: var(--white); border: 1px solid var(--rule); border-radius: 2px; }
  .plan.featured { border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--yellow); }
  .flag { margin: 0 0 12px; font-size: 0.875rem; font-weight: 600; color: var(--slate); }
  .plan h2 { font-size: 2rem; }
  .line { margin: 8px 0 0; color: var(--ink-soft); min-height: 3.2em; }
  .price { margin: 24px 0 0; padding: 20px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); color: var(--mute); font-variant-numeric: tabular-nums; }
  .price b { font-family: var(--head); font-size: 2.75rem; color: var(--ink); margin-right: 4px; }
  ul { margin: 20px 0 28px; padding-left: 1.1em; display: grid; gap: 8px; flex: 1; }
  li::marker { color: var(--slate); }
  .plan .btn { align-self: flex-start; }
  .terms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 48px 0 0; }
  .terms div { padding-top: 16px; border-top: 1px solid var(--rule); }
  .terms dt { font-weight: 600; }
  .terms dd { margin: 4px 0 0; color: var(--ink-soft); }
  @media (max-width: 900px) { .plans, .terms { grid-template-columns: 1fr; } .line { min-height: 0; } }
</style>
