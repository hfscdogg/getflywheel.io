---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
const open = SITE.seats.total - SITE.seats.committed;
const seats = ['Marketing', 'Outbound', 'Support', 'System Designer', 'Not sure yet'];
const next = [
  'You apply. It takes about five minutes.',
  'You talk with an owner who runs an integration company, usually within two business days.',
  'We check that your metro is still open.',
  'You fill in the business brief and onboarding starts.',
];
---
<Base title="Apply for a founding seat" description="Apply for one of the last founding seats in the Flywheel network: AI staff for your integration firm, 12 months as the only member in your metro and lifetime pricing." crumbs={[{ name: 'Apply', url: '/apply/' }]} cta={false}>
  <section class="band">
    <div class="wrap grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Apply</span></nav>
        <h1>Apply for a founding seat.</h1>
        <p class="lede">{open} of {SITE.seats.total} founding seats are still open. Tell us about your firm.</p>
        <h2 class="h3">What happens next</h2>
        <ol class="next">{next.map((n) => <li>{n}</li>)}</ol>
      </div>
      <form class="form" id="apply" action={`mailto:${SITE.email}`} method="post" enctype="text/plain" data-stamp data-endpoint={SITE.applyEndpoint}>
        <div class="two">
          <label for="f-name">Your name<input id="f-name" name="name" autocomplete="name" required /></label>
          <label for="f-role">Your role<input id="f-role" name="role" placeholder="Owner, GM, operations…" autocomplete="organization-title" /></label>
        </div>
        <label for="f-firm">Firm<input id="f-firm" name="firm" autocomplete="organization" required /></label>
        <div class="two">
          <label for="f-site">Website<input id="f-site" name="website" type="url" placeholder="https://" autocomplete="url" /></label>
          <label for="f-metro">Metro<input id="f-metro" name="metro" placeholder="e.g. Denver" required /></label>
        </div>
        <div class="two">
          <label for="f-email">Email<input id="f-email" name="email" type="email" autocomplete="email" required /></label>
          <label for="f-size">Team size<select id="f-size" name="team_size"><option>1–10</option><option>11–25</option><option>26–50</option><option>51 or more</option></select></label>
        </div>
        <fieldset>
          <legend>Which seat would you hire first?</legend>
          <div class="choices">
            {seats.map((s, i) => <label class="choice" for={`f-seat-${i}`}><input type="radio" id={`f-seat-${i}`} name="first_seat" value={s} checked={i === 2} /><span>{s}</span></label>)}
          </div>
        </fieldset>
        <label for="f-notes">Anything else we should know?<textarea id="f-notes" name="notes" rows="4" placeholder="Your tool stack, what you’ve tried, what keeps you up at night."></textarea></label>
        <input class="hp" name="company_url" type="text" tabindex="-1" aria-hidden="true" autocomplete="off" />
        <button class="btn primary" type="submit" data-track="form_submit" data-label="Apply form">Send application</button>
        <p class="error" hidden>That didn’t send. Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll take it from here.</p>
        <p class="small">We read every application. It isn’t shared with anyone.</p>
      </form>
    </div>
  </section>
</Base>

<script is:inline>
  // Posts to the Apps Script when SITE.applyEndpoint is set. Until then, compose the same email as before.
  document.getElementById('apply').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = this;
    var data = new FormData(form);
    var endpoint = (form.dataset.endpoint || '').trim();
    if (!endpoint) {
      var lines = [];
      data.forEach(function (v, k) { if (v) lines.push(k.replace(/_/g, ' ') + ': ' + v); });
      location.href = 'mailto:' + form.action.replace('mailto:', '') + '?subject=' + encodeURIComponent('Founding seat application: ' + (data.get('firm') || '')) + '&body=' + encodeURIComponent(lines.join('\n'));
      return;
    }
    var button = form.querySelector('button[type="submit"]');
    var error = form.querySelector('.error');
    if (error) error.hidden = true;
    button.disabled = true;
    button.textContent = 'Sending…';
    fetch(endpoint, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(data) })
      .then(function () {
        if (typeof gtag === 'function') gtag('event', 'generate_lead');
        form.innerHTML = '<p class="thanks-title">Application received.</p><p>An owner who runs an integration company will reach out within two business days.</p>';
        form.setAttribute('role', 'status');
      })
      .catch(function () {
        button.disabled = false;
        button.textContent = 'Send application';
        if (error) error.hidden = false;
      });
  });
</script>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px 80px; align-items: start; }
  h1 { max-width: 12ch; }
  .lede { margin-top: 20px; }
  .h3 { font-size: 1.4rem; margin-top: 48px; }
  .next { margin: 16px 0 0; padding-left: 1.3em; display: grid; gap: 10px; color: var(--ink-soft); }
  .next li::marker { font-family: var(--head); font-weight: 700; color: var(--slate); }
  .form { background: var(--white); border: 1px solid var(--rule); border-top: 6px solid var(--yellow); border-radius: 2px; padding: clamp(24px, 4vw, 40px); display: grid; gap: 20px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label, legend { display: grid; gap: 6px; font-size: 0.92rem; font-weight: 600; }
  input, select, textarea { font: inherit; font-weight: 400; font-size: 1rem; color: var(--ink); background: var(--paper); border: 1px solid #b9b19c; border-radius: 2px; padding: 12px 14px; width: 100%; }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--yellow); outline-offset: 0; border-color: var(--ink); }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { margin-bottom: 10px; }
  .choices { display: flex; flex-wrap: wrap; gap: 8px; }
  .choice { display: inline-flex; cursor: pointer; }
  .choice input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .choice span { padding: 9px 14px; border: 1px solid #b9b19c; border-radius: 2px; background: var(--paper); font-weight: 500; }
  .choice input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .choice input:focus-visible + span { outline: 3px solid var(--slate); outline-offset: 2px; }
  .form .btn { justify-self: start; }
  .form .btn:disabled { opacity: 0.65; cursor: progress; }
  .small, .error { margin: 0; }
  .error { color: var(--oxblood); }
  .error a { color: inherit; }
  :global(.thanks-title) { font-family: var(--head); font-weight: 700; font-size: 1.75rem; margin: 0 0 12px; }
  :global(.form[role='status'] p) { margin: 0; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .two { grid-template-columns: 1fr; } }
</style>
