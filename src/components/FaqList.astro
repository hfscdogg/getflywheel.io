---
import type { Faq } from '../schema';
interface Props { faqs: Faq[]; label?: string; title?: string }
const { faqs, label = 'Questions', title = 'What owners ask us first' } = Astro.props;
---
<section class="section" id="faq">
  <div class="wrap split">
    <div>
      <p class="label">{label}</p>
      <h2>{title}</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
