---
// Five firms around the wheel. Each keeps its records. Patterns go in and better agents come back.
const firms = [
  { name: 'Livewire', state: 'lit' },
  { name: 'Founding firm', state: 'taken' },
  { name: 'Founding firm', state: 'taken' },
  { name: 'Seat four', state: 'open' },
  { name: 'Seat five', state: 'open' },
];
---
<figure class="net">
  <div class="panel">
    <img src="/brand/flywheel-symbol-color.svg" alt="" width="280" height="280" />
  </div>
  <p class="kicker">How the network works</p>
  <ul>
    {firms.map((f) => (
      <li class={f.state}>
        <span class="dot" aria-hidden="true"></span>
        <b>{f.name}</b>
        <span>{f.state === 'open' ? 'Open founding seat' : 'Records stay in its own warehouse'}</span>
      </li>
    ))}
  </ul>
  <figcaption>Patterns go in to the network and better agents come back out. Customer records never leave a member’s own warehouse.</figcaption>
</figure>

<style>
  .net { margin: 0; }
  .panel { background: var(--bone); display: grid; place-items: center; padding: 28px 20px; margin-bottom: 8px; }
  .panel img { width: min(100%, 280px); height: auto; }
  .kicker {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 18px 0 0;
  }
  ul { list-style: none; margin: 8px 0 0; padding: 0; }
  li { display: grid; grid-template-columns: 14px minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 10px 16px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); transform: translateY(1px); }
  .open .dot { background: transparent; border: 1.5px solid var(--ink); }
  b { font-family: var(--sans); font-weight: 700; }
  li span:last-child { color: var(--ink-soft); }
  figcaption { margin: 14px 0 0; font-size: 0.88rem; color: var(--mute); }
  @media (max-width: 520px) {
    li { grid-template-columns: 14px minmax(0, 1fr); }
    li span:last-child { grid-column: 2; }
  }
</style>
