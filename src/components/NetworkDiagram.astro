---
// The model in one picture, from the deck's "The model" slide: five firms around the wheel, each keeping its
// records in its own warehouse. Patterns go in to the network and better agents come back out.
const C = 400;
const firms = [
  { name: 'Livewire', note: 'Client zero', state: 'lit' },
  { name: 'Founding firm', note: 'Committed', state: 'taken' },
  { name: 'Founding firm', note: 'Committed', state: 'taken' },
  { name: 'Seat four', note: 'Open', state: 'open' },
  { name: 'Seat five', note: 'Open', state: 'open' },
].map((f, i) => {
  const a = ((-90 + i * 72) * Math.PI) / 180;
  const at = (r: number) => ({ x: C + r * Math.cos(a), y: C + r * Math.sin(a) });
  return { ...f, box: at(286), from: at(132), to: at(196) };
});
---
<figure class="net">
  <svg viewBox="0 0 800 800" role="img" aria-labelledby="net-title net-desc">
    <title id="net-title">How the Flywheel network works</title>
    <desc id="net-desc">Five member firms sit around the Flywheel wheel. Each firm keeps its records in its own warehouse. Patterns, playbooks and benchmarks go to the network, and better agents come back to every firm.</desc>
    <defs>
      <marker id="tip" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="#495e7d" /></marker>
    </defs>
    {firms.map((f) => (
      <line x1={f.from.x} y1={f.from.y} x2={f.to.x} y2={f.to.y} stroke="#495e7d" stroke-width="2" stroke-dasharray={f.state === 'open' ? '5 6' : undefined} opacity={f.state === 'open' ? 0.45 : 1} marker-start="url(#tip)" marker-end="url(#tip)" />
    ))}
    <image href="/brand/wheel-ink.png" x={C - 118} y={C - 121} width="236" height="242" />
    {firms.map((f) => (
      <g transform={`translate(${f.box.x - 110} ${f.box.y - 52})`}>
        <rect width="220" height="104" rx="2" fill={f.state === 'lit' ? '#f5d500' : f.state === 'open' ? 'none' : '#fbfaf7'} stroke={f.state === 'open' ? '#8f897b' : '#1e1e1e'} stroke-width="1.5" stroke-dasharray={f.state === 'open' ? '5 5' : undefined} />
        <text x="16" y="44" class:list={['firm', { dim: f.state === 'open' }]}>{f.name}</text>
        <text x="16" y="76" class="note">{f.state === 'open' ? 'Open founding seat' : 'Records stay here'}</text>
      </g>
    ))}
  </svg>
  <ol class="list" aria-hidden="true">
    {firms.map((f) => <li class={f.state}><b>{f.name}</b><span>{f.state === 'open' ? 'Open founding seat' : 'Records stay in its own warehouse'}</span></li>)}
  </ol>
  <figcaption>Patterns go in to the network and better agents come back out. Customer records never leave a member’s own warehouse.</figcaption>
</figure>

<style>
  .net { margin: 0; }
  svg { width: 100%; max-width: 620px; margin: 0 auto; display: block; }
  .firm { font-family: var(--head); font-weight: 700; font-size: 28px; fill: #1e1e1e; }
  .firm.dim { fill: #8f897b; }
  .note { font-family: var(--body); font-size: 19px; fill: #3d3b37; }
  figcaption { margin: 20px auto 0; max-width: 46ch; text-align: center; font-size: 0.9rem; color: var(--mute); }
  .list { display: none; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 640px) {
    svg { display: none; }
    .list { display: grid; gap: 8px; }
    .list li { display: grid; gap: 2px; padding: 12px 14px; border: 1.5px solid var(--ink); background: var(--white); border-radius: 2px; }
    .list b { font-family: var(--head); font-size: 1.2rem; }
    .list span { font-size: 0.9rem; color: var(--ink-soft); }
    .list .lit { background: var(--yellow); }
    .list .open { background: none; border-style: dashed; border-color: var(--mute); color: var(--mute); }
    figcaption { text-align: left; }
  }
</style>
