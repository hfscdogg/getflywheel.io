---
// The Flywheel mark: a ring with five seats on it, one lit. Five founding firms, one wheel.
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
const seats = [0, 72, 144, 216, 288].map((deg) => {
  const r = (deg - 90) * (Math.PI / 180);
  return { x: 16 + 11 * Math.cos(r), y: 16 + 11 * Math.sin(r) };
});
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="2.2" />
  <circle cx="16" cy="16" r="3" fill="currentColor" />
  {seats.map((s, i) => <rect x={s.x - 3} y={s.y - 3} width="6" height="6" fill={i === 0 ? '#f0d000' : 'currentColor'} />)}
</svg>
